<?xml version="1.0" encoding="utf-8"?>
<!--
    10-foot sizing, budgeted against a real display.

    The floor is a 1080p set at xhdpi: 1920x1080px at 2.0 = 960x540dp. Every
    fixed height on a screen has to fit inside 540dp, because a TV has no
    scrolling and the clipped half of a layout is simply gone. A 4K set is
    1280x720dp and gets the slack back as breathing room.

    The home screen is the reference budget:

        padding       24 + 24 =  48
        header        icon row        48
        hero card     content        ~210
        button        96 + margin 20  116
        nav rail      92 + margin 24  116
        footnote      label           22

    That is about 560dp of fixed content, so the weighted Space above the hero
    takes the difference rather than the layout overflowing. The sizes below
    are the ones that make that work on 540dp, not a hope that a set is taller.

    The one hard number is tv_button_h: a focused button has to be tall enough
    that the platform's focus glow does not sit on top of the label. 96dp
    clears that; below about 80dp the glow eats the text.
-->
<resources>
    <!-- One gutter for every screen. This used to be 72dp, which is 7.5% of a
         960dp-wide panel — safe for overscan but 24dp more than needed, and it
         made the content edge jump between the home screen (which used its own
         value) and every other screen. 48dp is the 5% that TV overscan
         guidance actually asks for, and it gives the settings grid 48dp of
         extra width for long Russian and German labels. -->
    <dimen name="tv_screen_padding_h">48dp</dimen>
    <dimen name="tv_screen_padding_v">24dp</dimen>
    <dimen name="tv_gap_l">24dp</dimen>
    <dimen name="tv_gap_m">16dp</dimen>
    <dimen name="tv_gap_s">8dp</dimen>

    <dimen name="tv_hero_width">720dp</dimen>
    <dimen name="tv_hero_padding">20dp</dimen>
    <dimen name="tv_hero_corner">24dp</dimen>

    <dimen name="tv_status_dot">22dp</dimen>

    <dimen name="tv_button_w">300dp</dimen>
    <dimen name="tv_button_h">96dp</dimen>

    <!-- Rail cards are weighted, not fixed width, so the row fills whatever
         the set is wide enough for. Height is fixed and budgeted above. -->
    <dimen name="tv_nav_card_h">92dp</dimen>
    <dimen name="tv_nav_corner">16dp</dimen>
    <dimen name="tv_nav_padding">14dp</dimen>

    <dimen name="tv_row_padding">16dp</dimen>
    <dimen name="tv_row_corner">12dp</dimen>

    <dimen name="tv_icon_40">40dp</dimen>
    <dimen name="tv_icon_32">32dp</dimen>

    <!-- QR code, budgeted the same way as the rest: header 48 + gap 16 + code
         300 + gap 16 + bottom padding 24 is 404dp, leaving the right-hand
         column room for four mode chips and two buttons on a 540dp set. -->
    <dimen name="tv_qr_size">300dp</dimen>

    <!-- Import action cards. Taller than the settings toggle cards because each
         one carries two text lines, and two rows of them plus the header, the
         note and the status line fit in 540dp. -->
    <dimen name="tv_action_card_h">120dp</dimen>

    <!-- Settings group cards. A group is a title over a row of toggle chips,
         so one card carries up to four settings instead of one row apiece.
         Eight (padding) + 20 (the title) + 6 (title gap) + 72 (chip row)
         + 8 (padding) is 114dp per card, and five of them tile a 2 x 3 grid
         at 3 x 114 + 2 x 20 = 382dp, inside the 404dp the screen header
         leaves. Height is fixed rather than wrap so both columns stay level. -->
    <dimen name="tv_group_padding_v">8dp</dimen>
    <dimen name="tv_group_title_gap">6dp</dimen>
    <dimen name="tv_group_chip_h">72dp</dimen>
    <!-- Gutter between the two group columns, and between cards in one
         column. Split as two 10dp margins so the pair is one value to reason
         about here and a plain margin in the layout. -->
    <dimen name="tv_column_gutter">10dp</dimen>
    <dimen name="tv_group_gap">20dp</dimen>

    <!-- Keep-alive layer rows. Three rows plus header, note and the honest
         footer have to fit in 540dp: 48 + 48 + 16 + 36 + 16 + 3x84 + 2x12 + 16
         + 44 = 500, with 40dp of slack for a footer that wraps to two lines. -->
    <dimen name="tv_ka_row_h">84dp</dimen>
    <dimen name="tv_ka_action_w">220dp</dimen>
    <dimen name="tv_ka_action_h">60dp</dimen>

    <!-- ══════════════════════════════════════════════════════════════════
         10-foot rail, focus ring and card system.

         The rail budget is the reason this block exists. The previous item
         was 72dp plus 4dp of margin on each side, which is 80dp per row:
         7 rows = 560dp against the 424dp a rail actually gets on a 1080p set
         (540dp tall, minus 24dp of padding top and bottom, minus the 68dp
         brand row). 136dp of overflow meant the last two destinations —
         Keep-alive and About — were simply not on screen until the remote
         scrolled the rail, which is exactly the thing a TV UI is not
         supposed to require.

         At 52dp + a 4dp gap the seven rows are 392dp and fit with 32dp to
         spare. The label stays at 17sp because that is the smallest size
         that still reads from a sofa; the row gets shorter, the text does
         not.
         ══════════════════════════════════════════════════════════════════ -->
    <dimen name="tv_rail_w">200dp</dimen>
    <dimen name="tv_rail_pad_h">10dp</dimen>
    <dimen name="tv_rail_pad_v">12dp</dimen>
    <dimen name="tv_rail_brand_h">50dp</dimen>
    <dimen name="tv_rail_item_h">52dp</dimen>
    <dimen name="tv_rail_corner">14dp</dimen>
    <dimen name="tv_rail_icon">23dp</dimen>
    <dimen name="tv_rail_accent_w">3dp</dimen>
    <dimen name="tv_rail_foot_gap">10dp</dimen>

    <!-- Focus ring. 3dp is the thinnest stroke that still reads as a ring
         rather than a border at three metres; below 2dp it dissolves into
         the card edge on a dark panel. -->
    <dimen name="tv_focus_ring">3dp</dimen>
    <dimen name="tv_card_stroke">1dp</dimen>

    <!-- Card and content geometry. Three radii only: hero, card, row. -->
    <dimen name="tv_hero_radius">26dp</dimen>
    <dimen name="tv_card_radius">20dp</dimen>

    <!-- Home is two columns, not a vertical stack: a 16:9 screen has width to
         spend and the phone layout was leaving two thirds of it empty. -->
    <dimen name="tv_home_col_w">250dp</dimen>
    <dimen name="tv_home_gap">18dp</dimen>
    <dimen name="tv_home_card_gap">14dp</dimen>
    <dimen name="tv_hero_pad">24dp</dimen>
    <dimen name="tv_hero_btn_h">62dp</dimen>
    <dimen name="tv_hero_btn_w">246dp</dimen>
</resources>
