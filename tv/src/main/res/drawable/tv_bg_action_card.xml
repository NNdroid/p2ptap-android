<?xml version="1.0" encoding="utf-8"?>
<!--
    Action card background, with one extra state: selected.

    On the import screen the only card that is ever selected is "generate new
    identity", the arm state between the two confirming presses. That state is
    coloured for danger rather than reusing the settings green, because selected
    on a destructive card means "this next press will erase something" and a
    viewer who has been looking at green switches all day must not read it as
    safe.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#4C0519" />
            <stroke android:width="2dp" android:color="#F87171" />
            <corners android:radius="@dimen/tv_nav_corner" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <stroke android:width="2dp" android:color="#06B6D4" />
            <corners android:radius="@dimen/tv_nav_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F172A" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="@dimen/tv_nav_corner" />
        </shape>
    </item>
</selector>
