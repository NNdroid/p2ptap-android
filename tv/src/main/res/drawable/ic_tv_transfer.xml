<vector xmlns:android="http://schemas.android.com/apk/res/android"
  android:width="24dp"
  android:height="24dp"
  android:viewportWidth="24"
  android:viewportHeight="24"
  android:tint="#FFFFFF">
  <!-- Transfer: two opposed arrows, not one. This screen is bidirectional — a
       config can be read from a file and written back out as a QR — and a
       single arrow would advertise only half of it to someone reading the rail. -->
  <path
    android:pathData="M4,9 h13 M13,5 l4,4 l-4,4"
    android:strokeWidth="2"
    android:strokeColor="#FFFFFF"
    android:strokeLineCap="round"
    android:strokeLineJoin="round"
    android:fillColor="#00000000" />
  <path
    android:pathData="M20,15 h-13 M11,19 l-4,-4 l4,-4"
    android:strokeWidth="2"
    android:strokeColor="#FFFFFF"
    android:strokeLineCap="round"
    android:strokeLineJoin="round"
    android:fillColor="#00000000" />
</vector>
