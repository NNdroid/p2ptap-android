<?xml version="1.0" encoding="utf-8"?>
<!-- Glass hero, connecting state. Same four layers as tv_bg_hero_idle; only
     the state glow on layer 3 differs. See that file for the layer notes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_hero_radius" />
            <gradient
                android:angle="270"
                android:startColor="@color/tv_hero_fill_top"
                android:endColor="@color/tv_hero_fill_bottom" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_hero_radius" />
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="@color/tv_hero_sheen"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_hero_radius" />
            <gradient
                android:type="radial"
                android:gradientRadius="520dp"
                android:centerX="0.0"
                android:centerY="0.0"
                android:startColor="@color/tv_hero_glow_connecting"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_hero_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_hero_stroke" />
        </shape>
    </item>
</layer-list>
