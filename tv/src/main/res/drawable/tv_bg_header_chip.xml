<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary control in a screen header. Same palette as the tier chips so it
     reads as "another thing you can press" rather than as the screen's main
     action, which stays the toggle below. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#164E63" />
            <stroke android:width="2dp" android:color="#06B6D4" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F172A" />
            <stroke android:width="1dp" android:color="#1E293B" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
