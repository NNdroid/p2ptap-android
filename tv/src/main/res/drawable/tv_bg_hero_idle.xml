<?xml version="1.0" encoding="utf-8"?>
<!--
    Glass hero, idle state. Four layers, in paint order:

      1. fill      80–92% so the window gradient shows through
      2. sheen     white radial pinned above the top edge — "light on glass"
      3. glow      state tint, upper-left; grey here
      4. stroke    1dp white at 11.4% — the glass edge

    The three siblings (connecting / connected / error) are byte-identical
    apart from the glow colour on layer 3. That is deliberate: keeping the
    geometry fixed means a state change re-colours the card without the card
    jumping, which is what makes the transition read as "the same surface
    changed" rather than "a different card appeared".
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_hero_radius" />
            <gradient
                android:angle="270"
                android:startColor="@color/tv_hero_fill_top"
                android:endColor="@color/tv_hero_fill_bottom" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_hero_radius" />
            <gradient
                android:type="radial"
                android:gradientRadius="320dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="@color/tv_hero_sheen"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_hero_radius" />
            <gradient
                android:type="radial"
                android:gradientRadius="520dp"
                android:centerX="0.0"
                android:centerY="0.0"
                android:startColor="@color/tv_hero_glow_idle"
                android:endColor="#00000000" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tv_hero_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/tv_hero_stroke" />
        </shape>
    </item>
</layer-list>
