<?xml version="1.0" encoding="utf-8"?>
<!--
    Gradient hero surface. Kept as a state list so the card can deepen on focus
    without losing the gradient, which a plain <shape> cannot be tinted onto.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1E293B"
                android:centerColor="#0F172A"
                android:endColor="#1E1B4B" />
            <stroke android:width="2dp" android:color="#06B6D4" />
            <corners android:radius="@dimen/tv_hero_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0F172A"
                android:centerColor="#111827"
                android:endColor="#1E1B4B" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="@dimen/tv_hero_corner" />
        </shape>
    </item>
</selector>
