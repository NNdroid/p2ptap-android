<?xml version="1.0" encoding="utf-8"?>
<!--
    S4 Settings. A vertical RecyclerView of setting rows. Each row is either
    a toggle (switch) or a tier (segmented buttons).

    Layout is a two-column grid inside the RecyclerView: a category label
    on the left (240dp fixed), the control on the right (flex). This gives
    the eye a stable vertical anchor to return to when moving focus.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:padding="32dp">

    <TextView
        android:id="@+id/tv_screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_screen_settings"
        android:textAppearance="@style/TextAppearance.P2ptap.Tv.HeadlineMedium"
        android:textColor="@color/md_theme_onBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_screen_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/tv_screen_settings_hint"
        android:textAppearance="@style/TextAppearance.P2ptap.Tv.BodyMedium"
        android:textColor="@color/md_theme_onSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/tv_screen_title"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tv_settings_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:isScrollContainer="true"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_screen_subtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
