<?xml version="1.0" encoding="utf-8"?>
<!--
    S5: the engine's own counters.

    Two grids, no horizontal ScrollView. Scrolling by touch drag does not
    exist on a remote, and a HorizontalScrollView would still only scroll by
    D-pad — one keypress per item. Two columns mean every counter is a few
    focus hops away, and focus crosses from one column to the other with a
    single DPAD_LEFT.

    The empty state and the grid share the same weighted slot: only one of
    them is visible at a time, so the grid always gets the full viewport when
    there is data to show.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipChildren="false"
  android:clipToPadding="false"
  android:orientation="vertical"
  android:paddingStart="@dimen/tv_screen_padding_h"
  android:paddingTop="@dimen/tv_screen_padding_v"
  android:paddingEnd="@dimen/tv_screen_padding_h"
  android:paddingBottom="@dimen/tv_screen_padding_v">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/tv_screen_diagnostics"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.ScreenTitle" />

  <TextView
    android:id="@+id/tvDiagSummary"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tv_gap_s"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <TextView
    android:id="@+id/tvDiagEmpty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:focusable="false"
    android:gravity="center"
    android:text="@string/tv_diag_offline"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.HeroValue"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/tvDiagColumns"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:orientation="horizontal">

    <androidx.leanback.widget.VerticalGridView
      android:id="@+id/tvDiagLeft"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:isScrollContainer="true"
      android:paddingBottom="@dimen/tv_gap_l" />

    <Space
      android:layout_width="@dimen/tv_gap_l"
      android:layout_height="match_parent" />

    <androidx.leanback.widget.VerticalGridView
      android:id="@+id/tvDiagRight"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:clipToPadding="false"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:isScrollContainer="true"
      android:paddingBottom="@dimen/tv_gap_l" />
  </LinearLayout>
</LinearLayout>
