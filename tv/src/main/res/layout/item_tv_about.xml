<?xml version="1.0" encoding="utf-8"?>
<!--
    A labelled fact. The value is Body-sized rather than HeroValue-sized:
    this screen lists identities and addresses, which are long strings, and
    24sp bold would wrap an 46-character peer id across three rows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginBottom="@dimen/tv_gap_s"
  android:background="@drawable/tv_bg_row"
  android:focusable="true"
  android:focusableInTouchMode="true"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:padding="@dimen/tv_row_padding">

  <TextView
    android:id="@+id/tvAboutLabel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />

  <TextView
    android:id="@+id/tvAboutValue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />
</LinearLayout>
