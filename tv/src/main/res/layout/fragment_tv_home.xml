<?xml version="1.0" encoding="utf-8"?>
<!--
    S1 Home. Two zones:
    1. Hero card (top ~55%): status dot + state, node identity, up/down speeds,
       total counters, and the single primary toggle button. This is the
       surface a TV user opens the app for.
    2. Nav grid (bottom ~45%): four cards for Peers, Transfer, Settings,
       Diagnostics. Each card scales on focus and navigates to that screen.

    The nav grid exists so the primary action can always be reached without
    going through the rail, but the rail is the canonical navigation surface.

    Everything is a MaterialCardView with Widget.P2ptap.Tv.Card, which sets
    cardElevation=0dp (flat design, no drop shadow at TV distance) and
    cardCornerRadius=24dp.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context="app.fjj.p2ptap.tv.ui.TvHomeFragment">

    <!-- ════════════════════════════════════════════════════════════════════
         Hero card: connection status, identity, and the toggle.
         ════════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tv_hero_card"
        style="@style/Widget.P2ptap.Tv.Card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/md_theme_surface"
        app:cardElevation="0dp"
        app:cardCornerRadius="28dp"
        app:layout_constraintDimensionRatio="H,17:6"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_nav_grid_scroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp">

            <!-- Top row: brand label (left) and version info (right). -->
            <TextView
                android:id="@+id/tv_hero_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_hero_eyebrow"
                android:textAppearance="@style/TextAppearance.P2ptap.Tv.LabelSmall"
                android:textColor="@color/md_theme_onSurfaceVariant"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_hero_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.P2ptap.Tv.LabelSmall"
                android:textColor="@color/md_theme_onSurfaceVariant"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="v1.0.0 · engine 1.4.2" />

            <!-- Status row: dot + state label. -->
            <LinearLayout
                android:id="@+id/tv_status_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_hero_eyebrow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_hero_toggle">

                <View
                    android:id="@+id/tv_status_dot"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/tv_bg_status_dot"
                    android:backgroundTint="@color/tv_status_disconnected" />

                <TextView
                    android:id="@+id/tv_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.DisplaySmall"
                    android:textColor="@color/md_theme_onBackground"
                    tools:text="CONNECTED" />
            </LinearLayout>

            <!-- Toggle button (right of the status row). -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/tv_hero_toggle"
                style="@style/Widget.P2ptap.Tv.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_connect"
                app:icon="@drawable/ic_tv_power"
                app:iconGravity="start"
                app:iconSize="36dp"
                app:iconPadding="16dp"
                app:layout_constraintTop_toTopOf="@id/tv_status_row"
                app:layout_constraintBottom_toBottomOf="@id/tv_status_row"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Node identity: name, addresses. -->
            <LinearLayout
                android:id="@+id/tv_node_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/tv_status_row"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_node_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.HeadlineMedium"
                    android:textColor="@color/md_theme_onBackground"
                    tools:text="Mesh Node" />

                <TextView
                    android:id="@+id/tv_addresses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.BodyMedium"
                    android:textColor="@color/md_theme_onSurfaceVariant"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:ellipsize="middle"
                    tools:text="/ip4/10.0.0.88/tcp/4141 /ip6/fd00::88/tcp/4141" />
            </LinearLayout>

            <!-- Metrics row: 4 stat cells. -->
            <LinearLayout
                android:id="@+id/tv_metrics_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/tv_node_info"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tv_speed_tx_label"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.LabelSmall"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_tx_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.HeadlineSmall"
                    android:textColor="@color/md_theme_primary"
                    android:fontFamily="monospace"
                    tools:text="12.4 MB/s" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tv_speed_rx_label"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.LabelSmall"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_rx_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.HeadlineSmall"
                    android:textColor="@color/md_theme_tertiary"
                    android:fontFamily="monospace"
                    tools:text="3.1 MB/s" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tv_total_label"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.LabelSmall"
                    android:textColor="@color/md_theme_onSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_total_tx"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.BodyLarge"
                    android:textColor="@color/md_theme_onSurface"
                    android:fontFamily="monospace"
                    tools:text="1.2 GB" />

                <TextView
                    android:id="@+id/tv_peer_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.P2ptap.Tv.BodyLarge"
                    android:textColor="@color/md_theme_onSurface"
                    tools:text="4 peers" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ════════════════════════════════════════════════════════════════════
         Nav grid: 4 quick-nav cards below the hero.
         ════════════════════════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:id="@+id/tv_nav_grid_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tv_hero_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:divider="@color/md_theme_outlineVariant"
            android:showDividers="middle"
            android:dividerPadding="8dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tv_nav_peers"
                style="@style/Widget.P2ptap.Tv.Card.Focusable"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainer"
                app:cardElevation="0dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_tv_peers"
                        android:contentDescription="@null"
                        app:tint="@color/md_theme_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/tv_screen_peers"
                        android:textAppearance="@style/TextAppearance.P2ptap.Tv.TitleMedium"
                        android:textColor="@color/md_theme_onSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tv_screen_peers_hint"
                        android:textAppearance="@style/TextAppearance.P2ptap.Tv.BodySmall"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:maxLines="2"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tv_nav_transfer"
                style="@style/Widget.P2ptap.Tv.Card.Focusable"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainer"
                app:cardElevation="0dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_tv_transfer"
                        android:contentDescription="@null"
                        app:tint="@color/md_theme_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/tv_screen_transfer"
                        android:textAppearance="@style/TextAppearance.P2ptap.Tv.TitleMedium"
                        android:textColor="@color/md_theme_onSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tv_screen_transfer_hint"
                        android:textAppearance="@style/TextAppearance.P2ptap.Tv.BodySmall"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:maxLines="2"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tv_nav_settings"
                style="@style/Widget.P2ptap.Tv.Card.Focusable"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainer"
                app:cardElevation="0dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_tv_settings"
                        android:contentDescription="@null"
                        app:tint="@color/md_theme_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/tv_screen_settings"
                        android:textAppearance="@style/TextAppearance.P2ptap.Tv.TitleMedium"
                        android:textColor="@color/md_theme_onSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tv_screen_settings_hint"
                        android:textAppearance="@style/TextAppearance.P2ptap.Tv.BodySmall"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:maxLines="2"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tv_nav_diagnostics"
                style="@style/Widget.P2ptap.Tv.Card.Focusable"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/md_theme_surfaceContainer"
                app:cardElevation="0dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_tv_diagnostics"
                        android:contentDescription="@null"
                        app:tint="@color/md_theme_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/tv_screen_diagnostics"
                        android:textAppearance="@style/TextAppearance.P2ptap.Tv.TitleMedium"
                        android:textColor="@color/md_theme_onSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tv_screen_diagnostics_hint"
                        android:textAppearance="@style/TextAppearance.P2ptap.Tv.BodySmall"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        android:maxLines="2"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
