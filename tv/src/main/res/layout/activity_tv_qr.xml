<?xml version="1.0" encoding="utf-8"?>
<!--
    S3b: the code a phone reads.

    This is the only direction that leaves a TV on its own terms. A set-top box
    has no camera, so it cannot scan a code; it can only paint one and wait for
    something to look at it. That makes the screen one picture and one small
    control set: the bitmap, which text is inside it, and where to put a copy.

    Left-right rather than top-bottom, because a QR code has no spare width.
    A 300dp code plus its panel padding is about 340dp of the 540dp vertical
    budget on a 1080p set, which leaves the right column 300dp too, enough for
    the mode chips, the identity line and the two actions without scrolling.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="@dimen/tv_screen_padding_h"
  android:paddingTop="@dimen/tv_screen_padding_v"
  android:paddingEnd="@dimen/tv_screen_padding_h"
  android:paddingBottom="@dimen/tv_screen_padding_v">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="@dimen/tv_icon_40"
      android:layout_height="@dimen/tv_icon_40"
      android:contentDescription="@null"
      android:src="@drawable/ic_tv_qr" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tv_gap_s"
      android:layout_weight="1"
      android:text="@string/tv_screen_qr"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.ScreenTitle" />

    <TextView
      android:id="@+id/tvQrNodeName"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />
  </LinearLayout>

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- ── The code ───────────────────────────────────────────────── -->
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/tv_bg_hero_card"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="@dimen/tv_gap_m">

      <ImageView
        android:id="@+id/tvQrBitmap"
        android:layout_width="@dimen/tv_qr_size"
        android:layout_height="@dimen/tv_qr_size"
        android:adjustViewBounds="true"
        android:background="@color/tv_qr_panel"
        android:contentDescription="@string/tv_qr_hint"
        android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- ── What is inside it, and where to put it ─────────────────── -->
    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tv_gap_l"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_qr_hint"
        android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />

      <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_gap_m" />

      <!-- 2 x 2 mode grid: four payload kinds, no free text anywhere. -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
          android:id="@+id/tvQrModeBundle"
          android:layout_width="0dp"
          android:layout_height="@dimen/tv_tier_chip_h"
          android:layout_weight="1"
          android:background="@drawable/tv_bg_tier_chip"
          android:focusable="true"
          android:focusableInTouchMode="true"
          android:gravity="center"
          android:orientation="horizontal"
          android:text="@string/tv_qr_mode_bundle"
          android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />

        <LinearLayout
          android:id="@+id/tvQrModeConfig"
          android:layout_width="0dp"
          android:layout_height="@dimen/tv_tier_chip_h"
          android:layout_marginStart="@dimen/tv_gap_s"
          android:layout_weight="1"
          android:background="@drawable/tv_bg_tier_chip"
          android:focusable="true"
          android:focusableInTouchMode="true"
          android:gravity="center"
          android:orientation="horizontal"
          android:text="@string/tv_qr_mode_config"
          android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />
      </LinearLayout>

      <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_gap_s" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
          android:id="@+id/tvQrModeUri"
          android:layout_width="0dp"
          android:layout_height="@dimen/tv_tier_chip_h"
          android:layout_weight="1"
          android:background="@drawable/tv_bg_tier_chip"
          android:focusable="true"
          android:focusableInTouchMode="true"
          android:gravity="center"
          android:orientation="horizontal"
          android:text="@string/tv_qr_mode_uri"
          android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />

        <LinearLayout
          android:id="@+id/tvQrModeKey"
          android:layout_width="0dp"
          android:layout_height="@dimen/tv_tier_chip_h"
          android:layout_marginStart="@dimen/tv_gap_s"
          android:layout_weight="1"
          android:background="@drawable/tv_bg_tier_chip"
          android:focusable="true"
          android:focusableInTouchMode="true"
          android:gravity="center"
          android:orientation="horizontal"
          android:text="@string/tv_qr_mode_key"
          android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />
      </LinearLayout>

      <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_gap_l" />

      <TextView
        android:id="@+id/tvQrPeerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />

      <TextView
        android:id="@+id/tvQrTap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />

      <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_gap_l" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/tvQrCopy"
          android:layout_width="0dp"
          android:layout_height="@dimen/tv_button_h"
          android:layout_weight="1"
          android:background="@drawable/tv_bg_button_action"
          android:focusable="true"
          android:focusableInTouchMode="true"
          android:gravity="center"
          android:nextFocusRight="@id/tvQrSave"
          android:text="@string/tv_qr_copy"
          android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />

        <TextView
          android:id="@+id/tvQrSave"
          android:layout_width="0dp"
          android:layout_height="@dimen/tv_button_h"
          android:layout_marginStart="@dimen/tv_gap_m"
          android:layout_weight="1"
          android:background="@drawable/tv_bg_button_action"
          android:focusable="true"
          android:focusableInTouchMode="true"
          android:gravity="center"
          android:nextFocusLeft="@id/tvQrCopy"
          android:text="@string/tv_qr_save"
          android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
