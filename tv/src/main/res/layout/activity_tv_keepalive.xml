<?xml version="1.0" encoding="utf-8"?>
<!--
    S6: what keeps this tunnel alive, and whether each layer is actually doing
    it.

    The screen has no toggle and no slider. Each row is one layer, a read of
    whether that layer is alive, and one action. The three layers are independent
    on purpose — a box without Shizuku should still have boot restore and the
    in-process watchdog working, and it should not have to look like it is
    missing anything to know that.

    The footer is not a footnote about this screen, it is the honest statement
    of what none of the three layers can do. It stays visible rather than
    moving into a dialog, because the thing it says is the reason the other
    three rows exist.

    Height budget at 540dp: padding 48 + header 48 + gap 16 + note 36 + gap 16
    + 3 rows of 84 with 12 between + footer 44 + bottom padding 24 = 508.
    Nothing scrolls, on purpose.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="@dimen/tv_screen_padding_h"
  android:paddingTop="@dimen/tv_screen_padding_v"
  android:paddingEnd="@dimen/tv_screen_padding_h"
  android:paddingBottom="@dimen/tv_screen_padding_v">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="@dimen/tv_icon_40"
      android:layout_height="@dimen/tv_icon_40"
      android:contentDescription="@null"
      android:src="@drawable/ic_tv_keepalive" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tv_gap_s"
      android:layout_weight="1"
      android:text="@string/tv_screen_keepalive"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.ScreenTitle" />
  </LinearLayout>

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="2"
    android:text="@string/tv_ka_note"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <include
    android:id="@+id/tvKaBoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_ka_row_h"
    layout="@layout/item_tv_ka_layer" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_s" />

  <include
    android:id="@+id/tvKaWatchdog"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_ka_row_h"
    layout="@layout/item_tv_ka_layer" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_s" />

  <include
    android:id="@+id/tvKaShizuku"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_ka_row_h"
    layout="@layout/item_tv_ka_layer" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxLines="3"
    android:text="@string/tv_ka_foot"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />
</LinearLayout>
