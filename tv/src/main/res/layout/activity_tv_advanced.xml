<?xml version="1.0" encoding="utf-8"?>
<!--
    S4a: the settings that change how the tunnel behaves rather than whether it
    is on.

    These are kept off the main settings screen for one reason only: the 540dp
    floor. The main screen holds ten toggles and one rail with slack to spare,
    and adding three more rails there would push half the grid off the bottom
    of the picture, where it would be silently gone. One extra hop is cheaper
    than a clipped screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="@dimen/tv_screen_padding_h"
  android:paddingTop="@dimen/tv_screen_padding_v"
  android:paddingEnd="@dimen/tv_screen_padding_h"
  android:paddingBottom="@dimen/tv_screen_padding_v">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="@dimen/tv_icon_40"
      android:layout_height="@dimen/tv_icon_40"
      android:contentDescription="@null"
      android:src="@drawable/ic_tv_settings" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tv_gap_s"
      android:layout_weight="1"
      android:text="@string/tv_screen_advanced"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.ScreenTitle" />
  </LinearLayout>

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="2"
    android:text="@string/tv_advanced_note"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <include
    android:id="@+id/tvTierStrategy"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_tier_chip_h"
    layout="@layout/item_tv_tier" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_s" />

  <include
    android:id="@+id/tvTierLogLevel"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_tier_chip_h"
    layout="@layout/item_tv_tier" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_s" />

  <include
    android:id="@+id/tvTierMtu"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_tier_chip_h"
    layout="@layout/item_tv_tier" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <include
    android:id="@+id/tvCardBootMesh"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    layout="@layout/item_tv_toggle" />
</LinearLayout>
