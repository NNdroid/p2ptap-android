<?xml version="1.0" encoding="utf-8"?>
<!--
    Two-pane shell: a fixed-width rail on the left, a NavHostFragment on the
    right. The whole Activity is one FrameLayout because the platform's own
    decor (status bar, nav bar) sits outside our layout, and we do not want any
    extra container to steal pixels at 1080p.

    The rail is 240dp wide. That is roughly 12.5% of a 1920px panel at 16:9,
    which is the width Plex uses and gives 6–7 rail items comfortable vertical
    real estate (7 items * 154dp = 1078dp, fitting inside a 1080dp frame with
    4dp of breathing room top and bottom).
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context="app.fjj.p2ptap.tv.TvMainActivity">

    <!-- ════════════════════════════════════════════════════════════════════
         Left rail.
         ════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/tv_rail_container"
        android:layout_width="240dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/md_theme_surfaceContainerLow"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- App brand at the top of the rail. Small, quiet — the rail's
             identity, not a status bar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_tv_shield"
                android:contentDescription="@null"
                app:tint="@color/md_theme_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.P2ptap.Tv.TitleLarge"
                android:textColor="@color/md_theme_onSurface" />
        </LinearLayout>

        <!-- The rail itself. Vertical RecyclerView; each item is a
             MaterialButton-shaped tab. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tv_rail"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:isScrollContainer="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════════════
         Vertical divider between rail and content.
         ════════════════════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/tv_divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/md_theme_outlineVariant"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_rail_container" />

    <!-- ════════════════════════════════════════════════════════════════════
         Content area. NavHostFragment swaps destinations in here.
         ════════════════════════════════════════════════════════════════════ -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/tv_nav_host"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:navGraph="@navigation/tv_nav_graph"
        android:name="androidx.navigation.fragment.NavHostFragment"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>
