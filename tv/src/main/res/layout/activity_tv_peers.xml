<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipChildren="false"
  android:clipToPadding="false"
  android:orientation="vertical"
  android:paddingStart="@dimen/tv_screen_padding_h"
  android:paddingTop="@dimen/tv_screen_padding_v"
  android:paddingEnd="@dimen/tv_screen_padding_h"
  android:paddingBottom="@dimen/tv_screen_padding_v">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/tv_screen_peers"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.ScreenTitle" />

  <TextView
    android:id="@+id/tvPeersSummary"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tv_gap_s"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <!--
      Empty state shares the viewport with the grid. It is never focused: a
      TV user should be looking at peers, not at an explanation of why there
      are none, so it sits outside the focusable graph.
  -->
  <TextView
    android:id="@+id/tvPeersEmpty"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:focusable="false"
    android:gravity="center"
    android:text="@string/tv_peers_empty"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.HeroValue"
    android:visibility="gone" />

  <TextView
    android:id="@+id/tvPeersEmptyHint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:gravity="center"
    android:text="@string/tv_peers_empty_hint"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body"
    android:visibility="gone" />

  <androidx.leanback.widget.VerticalGridView
    android:id="@+id/tvPeersGrid"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:isScrollContainer="true"
    android:paddingTop="@dimen/tv_gap_s"
    android:paddingBottom="@dimen/tv_gap_l" />
</LinearLayout>
