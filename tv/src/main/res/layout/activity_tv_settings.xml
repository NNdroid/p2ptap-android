<?xml version="1.0" encoding="utf-8"?>
<!--
    S4: the settings a viewer actually changes.

    Nothing here has an EditText. A set-top box has no keyboard, so every
    change is a toggle press or a press on one of a small number of values.
    Anything that needs free text (bootstrap peers, DNS, SNI, PSK) is not
    reachable from a TV, which is why import/export exists.

    The grid takes the remaining height and the tier rail sits below it, fixed.
    At 540dp the grid gets about 360dp, which is six rows of 62dp, so the ten
    cards fit without scrolling on a 1080p set and scroll cleanly on anything
    shorter. The rail does not move, because a value that changes under you
    while you are still reading the grid is the one thing that is confusing.

    The header chip opens the second-level screen rather than a BottomSheet:
    the platform's BottomSheet dismiss gesture does not exist on a remote.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="@dimen/tv_screen_padding_h"
  android:paddingTop="@dimen/tv_screen_padding_v"
  android:paddingEnd="@dimen/tv_screen_padding_h"
  android:paddingBottom="@dimen/tv_screen_padding_v">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="@dimen/tv_icon_40"
      android:layout_height="@dimen/tv_icon_40"
      android:contentDescription="@null"
      android:src="@drawable/ic_tv_settings" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tv_gap_s"
      android:layout_weight="1"
      android:text="@string/tv_screen_settings"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.ScreenTitle" />

    <TextView
      android:id="@+id/tvSettingsAdvanced"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/tv_bg_header_chip"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:gravity="center"
      android:nextFocusLeft="@id/tvToggleGrid"
      android:nextFocusUp="@id/tvToggleGrid"
      android:paddingStart="20dp"
      android:paddingTop="12dp"
      android:paddingEnd="20dp"
      android:paddingBottom="12dp"
      android:text="@string/tv_nav_advanced"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />

    <!--
        The three screens a viewer reaches from here. Header chips rather than
        cards below the grid, because the grid already owns the last 352dp of a
        540dp set: ten toggles at 62dp a row is 310dp, so a fourth row has no
        room and anything placed below the tier rail clips off the bottom.
    -->
    <TextView
      android:id="@+id/tvSettingsKeepAlive"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tv_gap_s"
      android:background="@drawable/tv_bg_header_chip"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:gravity="center"
      android:nextFocusLeft="@id/tvSettingsAdvanced"
      android:nextFocusUp="@id/tvToggleGrid"
      android:paddingStart="20dp"
      android:paddingTop="12dp"
      android:paddingEnd="20dp"
      android:paddingBottom="12dp"
      android:text="@string/tv_nav_keepalive"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />

    <TextView
      android:id="@+id/tvSettingsAbout"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tv_gap_s"
      android:background="@drawable/tv_bg_header_chip"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:gravity="center"
      android:nextFocusLeft="@id/tvSettingsKeepAlive"
      android:nextFocusUp="@id/tvToggleGrid"
      android:paddingStart="20dp"
      android:paddingTop="12dp"
      android:paddingEnd="20dp"
      android:paddingBottom="12dp"
      android:text="@string/tv_nav_about"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />
  </LinearLayout>

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <androidx.leanback.widget.VerticalGridView
    android:id="@+id/tvToggleGrid"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:isScrollContainer="true"
    android:nextFocusDown="@id/tvTierObfuscation"
    android:overScrollMode="never" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_s" />

  <include
    android:id="@+id/tvTierObfuscation"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_tier_chip_h"
    layout="@layout/item_tv_tier" />
</LinearLayout>
