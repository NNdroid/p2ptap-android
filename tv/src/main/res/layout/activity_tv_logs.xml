<?xml version="1.0" encoding="utf-8"?>
<!--
    The tunnel's own log, as a live tail.

    There is deliberately no scrolling here. A remote has no drag, and a
    scrollable text pane from ten feet is unreadable anyway, so this screen
    shows the newest lines only and refreshes them as they arrive — the
    equivalent of `tail -f`. The full history is still in the ring buffer and
    reachable by widening the pane; this layout simply chooses not to.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/tvLogsRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:focusable="false"
  android:orientation="vertical"
  android:paddingStart="@dimen/tv_screen_padding_h"
  android:paddingTop="@dimen/tv_screen_padding_v"
  android:paddingEnd="@dimen/tv_screen_padding_h"
  android:paddingBottom="@dimen/tv_screen_padding_v">

  <!-- ── Header ─────────────────────────────────────────────────────── -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="@dimen/tv_icon_40"
      android:layout_height="@dimen/tv_icon_40"
      android:contentDescription="@null"
      android:src="@drawable/ic_tv_logs" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tv_gap_s"
      android:layout_weight="1"
      android:text="@string/tv_screen_logs"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.ScreenTitle" />

    <TextView
      android:id="@+id/tvLogsStatus"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="end"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />
  </LinearLayout>

  <!-- ── The tail ───────────────────────────────────────────────────── -->
  <TextView
    android:id="@+id/tvLogPane"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="@dimen/tv_gap_m"
    android:layout_weight="1"
    android:background="@drawable/tv_bg_log_pane"
    android:fontFamily="monospace"
    android:gravity="bottom"
    android:isScrollContainer="true"
    android:lineSpacingExtra="2dp"
    android:overScrollMode="never"
    android:padding="20dp"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Log"
    android:textIsSelectable="false" />

  <!-- ── Actions ────────────────────────────────────────────────────── -->
  <!--
      Two buttons side by side trip lint's ButtonStyle check, which expects
      a borderless phone button bar. On TV a borderless button has no drawn
      focus target and vanishes when unselected, so these keep their own
      background drawable instead. The check is a phone heuristic; ignoring
      it here is deliberate, not incidental.
  -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tv_gap_m"
    android:gravity="center"
    android:orientation="horizontal"
    tools:ignore="ButtonStyle">

    <Button
      android:id="@+id/tvLogsErrorsOnly"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/tv_button_h"
      android:layout_marginEnd="@dimen/tv_gap_m"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:nextFocusLeft="@id/tvLogsClear"
      android:nextFocusRight="@id/tvLogsClear"
      android:nextFocusUp="@id/tvLogsClear"
      android:text="@string/tv_logs_errors_only" />

    <Button
      android:id="@+id/tvLogsClear"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/tv_button_h"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:nextFocusLeft="@id/tvLogsErrorsOnly"
      android:nextFocusRight="@id/tvLogsErrorsOnly"
      android:nextFocusUp="@id/tvLogsErrorsOnly"
      android:text="@string/tv_logs_clear" />
  </LinearLayout>
</LinearLayout>
