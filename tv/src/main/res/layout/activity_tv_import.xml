<?xml version="1.0" encoding="utf-8"?>
<!--
    S3a: how a configuration arrives.

    A set-top box has no keyboard, so nothing on this screen accepts typed text.
    Four presses, each of them the whole action: pick a file, pick another file,
    read whatever is on the clipboard, or throw away the identity and make a new
    one. The fourth is the only destructive thing here, which is why it sits
    last and why it asks before it runs.

    Height budget at 540dp: padding 48 + header 48 + note 36 + gap 16 + two
    rows of 120 cards + 8 + the QR link 60 = 436. Nothing scrolls.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:paddingStart="@dimen/tv_screen_padding_h"
  android:paddingTop="@dimen/tv_screen_padding_v"
  android:paddingEnd="@dimen/tv_screen_padding_h"
  android:paddingBottom="@dimen/tv_screen_padding_v">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="@dimen/tv_icon_40"
      android:layout_height="@dimen/tv_icon_40"
      android:contentDescription="@null"
      android:src="@drawable/ic_tv_import" />

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tv_gap_s"
      android:layout_weight="1"
      android:text="@string/tv_screen_import"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.ScreenTitle" />

    <TextView
      android:id="@+id/tvImportQr"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/tv_bg_header_chip"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:gravity="center"
      android:nextFocusLeft="@id/tvImportClipboard"
      android:nextFocusUp="@id/tvImportClipboard"
      android:paddingStart="20dp"
      android:paddingTop="12dp"
      android:paddingEnd="20dp"
      android:paddingBottom="12dp"
      android:text="@string/tv_screen_qr"
      android:textAppearance="@style/TextAppearance.P2ptap.Tv.Label" />
  </LinearLayout>

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/tv_import_note"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <include
      android:id="@+id/tvImportConfig"
      android:layout_width="0dp"
      android:layout_height="@dimen/tv_action_card_h"
      android:layout_weight="1"
      layout="@layout/item_tv_action_card" />

    <Space
      android:layout_width="@dimen/tv_gap_m"
      android:layout_height="match_parent" />

    <include
      android:id="@+id/tvImportIdentity"
      android:layout_width="0dp"
      android:layout_height="@dimen/tv_action_card_h"
      android:layout_weight="1"
      layout="@layout/item_tv_action_card" />
  </LinearLayout>

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_s" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <include
      android:id="@+id/tvImportClipboard"
      android:layout_width="0dp"
      android:layout_height="@dimen/tv_action_card_h"
      android:layout_weight="1"
      layout="@layout/item_tv_action_card" />

    <Space
      android:layout_width="@dimen/tv_gap_m"
      android:layout_height="match_parent" />

    <include
      android:id="@+id/tvImportNew"
      android:layout_width="0dp"
      android:layout_height="@dimen/tv_action_card_h"
      android:layout_weight="1"
      layout="@layout/item_tv_action_card" />
  </LinearLayout>

  <Space
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_gap_m" />

  <TextView
    android:id="@+id/tvImportStatus"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="middle"
    android:maxLines="2"
    android:textAppearance="@style/TextAppearance.P2ptap.Tv.Body" />
</LinearLayout>
