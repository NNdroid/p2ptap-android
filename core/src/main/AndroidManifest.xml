<?xml version="1.0" encoding="utf-8"?>
<!--
    Permissions this module's own code needs. The manifest merger unions them
    into every app that depends on :core, so :tv picks up the same VPN
    runtime permissions instead of repeating them.

    App-private permissions stay with each app: CAMERA for QR scanning lives in
    :mobile, and :tv has no camera at all.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
