<?xml version="1.0" encoding="utf-8"?>
<!-- Address-list manager sheet.

     Rebuilt on the M3 surface language. The sheet supplies the surface, so the
     root is transparent and the footer no longer paints a second solid band
     over it — the separation is carried by a 2dp seam, same as every card in
     the app.

     One functional fix: the close affordance was drawing ic_delete (a trash
     can) in the top-right corner, which reads as "delete everything". It is
     now ic_close. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- Fixed Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dialog_manage_addresses"
            android:textColor="?attr/colorOnSurface"
            android:textFontWeight="600"
            android:textSize="20sp" />

        <!-- Switch Mode Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleMode"
            style="@style/Widget.P2ptap.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="@string/btn_switch_text_mode"
            app:icon="@drawable/ic_text"
            app:iconSize="18dp" />

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_cancel"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/m3_seam" />

    <!-- Scrollable Middle Section -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="240dp"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- List Mode -->
        <LinearLayout
            android:id="@+id/layoutListMode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- RecyclerView with internal scrolling -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAddresses"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                tools:listitem="@layout/item_address_card" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_peers"
                    app:tint="?attr/colorOutline" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/empty_address_list"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Quick Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddAddress"
                    style="@style/Widget.P2ptap.Button.FilledTonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/btn_add_address"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_add"
                    app:iconSize="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanQr"
                    style="@style/Widget.P2ptap.Button.FilledTonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:text="@string/btn_scan_qr"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_qr_scan"
                    app:iconSize="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPasteClipboard"
                    style="@style/Widget.P2ptap.Button.FilledTonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/btn_paste_clip"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_paste"
                    app:iconSize="17dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Raw Text Mode -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutTextMode"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.P2ptap.TextField"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="@string/hint_input_address"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRawAddresses"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="monospace"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="8"
                    android:textSize="12sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/m3_seam" />

    <!-- Fixed Bottom Sticky Footer (Always Visible) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.P2ptap.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/btn_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveList"
            style="@style/Widget.P2ptap.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/btn_save_list" />
    </LinearLayout>

</LinearLayout>
