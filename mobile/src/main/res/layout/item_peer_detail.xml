<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="1dp" app:strokeColor="?attr/colorOutlineVariant" app:strokeWidth="1dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

    <!-- Header: Name + Badges -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvNodeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/telemetry_unknown" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
          <TextView android:id="@+id/tvBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="3dp" android:text="@string/telemetry_unknown" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_node_chip" />
          <TextView android:id="@+id/tvEncBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_node_chip" android:visibility="gone" />
          <TextView android:id="@+id/tvRoleBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:textSize="11sp" android:background="@drawable/bg_node_chip" android:visibility="gone" />
        </LinearLayout>
      </LinearLayout>
      <TextView android:id="@+id/tvGeoLocation" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
    </LinearLayout>

    <!-- RTT / Jitter / Loss Row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
      <TextView android:id="@+id/tvRtt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/telemetry_unknown" android:textColor="?attr/colorPrimary" android:textSize="12sp" android:textStyle="bold" />
      <TextView android:id="@+id/tvJitter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/telemetry_unknown" android:textColor="?attr/colorSecondary" android:textSize="12sp" android:visibility="gone" />
      <TextView android:id="@+id/tvLoss" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/telemetry_unknown" android:textColor="?attr/colorError" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>

    <!-- Connection Duration + Return Path -->
    <LinearLayout android:id="@+id/layoutDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="6dp" android:visibility="gone">
      <TextView android:id="@+id/tvConnectedSince" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" />
      <TextView android:id="@+id/tvReturnPath" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Return-path medium (observed inbound transport; may differ from the forward badge) -->
    <TextView android:id="@+id/tvReturnTransport" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant" android:layout_marginBottom="6dp" android:visibility="gone" />

    <!-- TAP IPs -->
    <TextView android:id="@+id/tvIpAddresses" android:layout_width="match_parent" android:layout_height="wrap_content" android:breakStrategy="high_quality" android:text="@string/telemetry_unknown" android:textColor="?attr/colorSecondary" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="6dp" />

    <!-- Peer ID with Copy -->
    <LinearLayout android:id="@+id/layoutPeerId" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:orientation="horizontal" android:layout_marginBottom="6dp">
      <TextView android:id="@+id/tvPeerId" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="middle" android:fontFamily="monospace" android:singleLine="true" android:text="@string/telemetry_unknown" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
      <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_copy" app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Endpoint -->
    <TextView android:id="@+id/tvEndpoint" android:layout_width="match_parent" android:layout_height="wrap_content" android:breakStrategy="high_quality" android:fontFamily="monospace" android:text="@string/telemetry_unknown" android:textColor="?attr/colorOutline" android:textSize="10sp" android:layout_marginBottom="8dp" android:lineSpacingExtra="2dp" />

    <!-- Traffic + Diagnostics -->
    <TextView android:id="@+id/tvTraffic" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/telemetry_unknown" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" android:lineSpacingExtra="2dp" />

    <!-- TAP MAC Mismatch Warning -->
    <TextView android:id="@+id/tvTapMacWarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="6dp" android:textSize="11sp" android:textStyle="bold" android:textColor="?attr/colorError" android:background="@drawable/bg_code_block" android:visibility="gone" />

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>