<?xml version="1.0" encoding="utf-8"?>
<!-- One peer card in the peers tab.

     Two changes from the dialog version, both about information hierarchy:

     1. The badges used to be primary_container chips on every card, which made
        three cyan pills the loudest thing in the list. They are soft state
        containers now — green for direct, blue for relayed, amber for
        connecting, red for failed — and the neutral one is reserved for facts
        that carry no state (encryption algorithm, role). PeersTab sets the
        fill and the text colour as a pair via paintTag().

     2. The name leads at 16sp/500 and everything else steps down — RTT and
        link traffic are monospace because they are numbers that change width
        every 1.5s, and proportional digits make the card twitch.

     Ids are unchanged: PeersTab binds this layout with exactly these names. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/m3_card"
    app:cardCornerRadius="@dimen/m3_card_radius_small"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/m3_row_pad_h"
        android:paddingVertical="16dp">

        <!-- Header: name + badges on the left, geo on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNodeName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.01"
                    android:text="@string/telemetry_unknown"
                    android:textColor="?attr/colorOnSurface"
                    android:textFontWeight="500"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_neutral"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:text="@string/telemetry_unknown"
                        android:textFontWeight="500"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvEncBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_tag_neutral"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:textFontWeight="500"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvRoleBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_tag_neutral"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="3dp"
                        android:textFontWeight="500"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvGeoLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- RTT / Jitter / Loss — one monospace line, tabular by nature -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRtt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="@string/telemetry_unknown"
                android:textColor="?attr/colorPrimary"
                android:textFontWeight="600"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvJitter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="monospace"
                android:text="@string/telemetry_unknown"
                android:textColor="?attr/colorSecondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLoss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="monospace"
                android:text="@string/telemetry_unknown"
                android:textColor="?attr/colorError"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Connection duration + return path -->
        <LinearLayout
            android:id="@+id/layoutDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvConnectedSince"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvReturnPath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Return-path medium. Observed from the peer's inbound frames, so it
             may legitimately differ from the forward badge above — that
             difference is exactly the asymmetric routing worth surfacing. -->
        <TextView
            android:id="@+id/tvReturnTransport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <!-- TAP IPs — tap to copy -->
        <TextView
            android:id="@+id/tvIpAddresses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:breakStrategy="high_quality"
            android:fontFamily="monospace"
            android:text="@string/telemetry_unknown"
            android:textColor="@color/status_connected"
            android:textFontWeight="600"
            android:textSize="12sp" />

        <!-- Peer ID — inset row, tap to copy -->
        <LinearLayout
            android:id="@+id/layoutPeerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_code_block"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/tvPeerId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="@string/telemetry_unknown"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/label_peer_id"
                android:src="@drawable/ic_copy"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Endpoint -->
        <TextView
            android:id="@+id/tvEndpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:breakStrategy="high_quality"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text="@string/telemetry_unknown"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="10.5sp" />

        <!-- Traffic + diagnostics -->
        <TextView
            android:id="@+id/tvTraffic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text="@string/telemetry_unknown"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11.5sp" />

        <!-- TAP MAC mismatch warning -->
        <TextView
            android:id="@+id/tvTapMacWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_warning_block"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:textColor="@color/md_on_error_container"
            android:textFontWeight="500"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
