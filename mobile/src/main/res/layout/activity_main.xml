<?xml version="1.0" encoding="utf-8"?>
<!-- App shell.

     There is no Toolbar any more. The M3 Expressive layout this app now
     follows puts the page name in a 34sp headline inside the scrolling
     content of each tab fragment. Settings is ConfigFragment here — the
     separate ConfigActivity with its own bar and back arrow is gone, along
     with the bar-sync bugs that structure caused.

     The four tab bodies are Fragments (HomeFragment / PeersFragment /
     TrafficFragment / ConfigFragment), swapped into this container with
     add/hide rather than replace, so a tab keeps its scroll position and its
     disclosure state when you come back to it. They share one MainViewModel
     through `by activityViewModels()`, so the engine is still polled once,
     not three times.

     Sizing: the content frame takes the weight, the dock is a fixed 80dp, so
     nothing is ever hidden behind the bar and no scroll view needs a bottom
     inset. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.P2ptap.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/m3_nav_height"
        app:menu="@menu/menu_bottom_nav" />

</LinearLayout>
