<?xml version="1.0" encoding="utf-8"?>
<!-- Log viewer.

     Relaid on the M3 surface language, and two controls changed shape rather
     than just colour:

     · the level filter was a scrolling ChipGroup, which read as five
       independent toggles. It is a segmented pill now — one control, five
       mutually exclusive states, which is exactly what it means;
     · the four actions were full text buttons that took a whole row. They are
       icon buttons on the search line, so the log itself gets the height.

     Toolbar stays: this is a pushed screen, and back navigation belongs in an
     app bar. The home shell has no toolbar at all, so this is the only place
     one shows up. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_page"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/m3_page"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/title_log_viewer"
            app:titleTextColor="?attr/colorOnSurface" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Search + action icons on one line: the log block needs the height
             more than the buttons do. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.P2ptap.TextField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_search_logs"
                app:boxBackgroundMode="outline"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTheme"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/action_toggle_theme"
                app:icon="@drawable/ic_theme_mode"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPauseResume"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/btn_pause_logs"
                app:icon="@drawable/ic_pause"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareLogs"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/btn_share_logs"
                app:icon="@drawable/ic_share"
                app:iconTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearLogs"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/btn_clear_logs"
                app:icon="@drawable/ic_delete"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Level filter: one segmented control, five exclusive states -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleLevels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            app:checkedButton="@id/chipAll"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipAll"
                style="@style/Widget.P2ptap.SegmentButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipInfo"
                style="@style/Widget.P2ptap.SegmentButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_info" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipWarn"
                style="@style/Widget.P2ptap.SegmentButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_warn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipError"
                style="@style/Widget.P2ptap.SegmentButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipDebug"
                style="@style/Widget.P2ptap.SegmentButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/filter_debug" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Log block: a tonal container, not a bordered box -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/m3_card"
            app:cardCornerRadius="@dimen/m3_card_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/logs_initializing"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </ScrollView>
        </com.google.android.material.card.MaterialCardView>

        <!-- Footer: count on the left, copy on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLogStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:text="@string/telemetry_loading"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyLogs"
                style="@style/Widget.P2ptap.Button.FilledTonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_copy_logs"
                android:textSize="13sp"
                app:icon="@drawable/ic_copy"
                app:iconSize="17dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
