<resources>
    <dimen name="fab_margin">16dp</dimen>

    <!-- The card language every settings group shares. Cards 1 to 7 of
         fragment_config.xml all repeat the same corner radius, stroke,
         elevation and inner padding, so a radius change has to land in one
         place instead of in seven card blocks. -->
    <!-- 28dp is the M3 Expressive large radius and the only one used at page
         level: hero, settings group, list card and dialog inner card all take
         it, so switching screens never shows two competing radii. -->
    <dimen name="card_corner_radius">28dp</dimen>
    <!-- 0dp, not 2dp. Elevation is gone from this language entirely — depth
         comes from the card fill being one tonal step away from the page, and
         a shadow on top of that reads as a second, conflicting cue. -->
    <dimen name="card_elevation">0dp</dimen>
    <dimen name="card_padding">20dp</dimen>
    <dimen name="card_gap">16dp</dimen>

    <!-- Compact icon-button box. The log viewer puts four of these next to a
         search field on a 360dp-wide screen; at 48dp each they consumed 204dp
         and squeezed the field to ~130dp. -->
    <dimen name="icon_button_size">40dp</dimen>

    <!-- Screen padding around the scrolling settings column. -->
    <dimen name="screen_padding">16dp</dimen>

    <!-- ── Main screen (home_*) tokens ────────────────────────────────────
         One radius scale for the whole page now, so these all resolve to the
         same 28dp; they stay separate names because the hero is padded wider
         than a list card and the two should be tunable independently. -->
    <dimen name="home_screen_padding">16dp</dimen>
    <dimen name="home_hero_radius">28dp</dimen>
    <dimen name="home_hero_padding">20dp</dimen>
    <dimen name="home_card_radius">28dp</dimen>
    <dimen name="home_card_padding">20dp</dimen>
    <!-- Gap between cards that belong to the same group. -->
    <dimen name="home_gap">16dp</dimen>
    <!-- Gap that separates one group of cards from the next. -->
    <dimen name="home_group_gap">22dp</dimen>
    <!-- 56dp circle with a 26dp glyph: the ring is a state container, not a
         hero illustration, so it stays close to the status text. -->
    <dimen name="home_ring_size">56dp</dimen>
    <dimen name="home_ring_icon">26dp</dimen>
    <dimen name="home_cta_height">52dp</dimen>
    <dimen name="home_metric_min_height">56dp</dimen>
    <dimen name="home_row_min_height">44dp</dimen>

    <!-- ════════════════════════════════════════════════════════════════
         M3 Expressive component tokens
         ════════════════════════════════════════════════════════════════ -->
    <!-- Rows of a grouped card. Horizontal padding is the card's 20dp so text
         lines up with the card header; the 2dp seam is the page colour. -->
    <dimen name="m3_row_pad_h">20dp</dimen>
    <dimen name="m3_row_pad_v">14dp</dimen>
    <dimen name="m3_seam">2dp</dimen>
    <!-- Page-level card radius (28dp) and the one nested step below it (24dp,
         used by a peer card that already sits inside the page gutter). -->
    <dimen name="m3_card_radius">28dp</dimen>
    <dimen name="m3_card_radius_small">24dp</dimen>
    <!-- Section label above a group of cards ("虚拟网络（L2/L3）"). -->
    <dimen name="m3_section_gap_top">22dp</dimen>
    <dimen name="m3_section_gap_bottom">8dp</dimen>

    <!-- Filled / tonal buttons: 52dp tall, 26dp radius = full pill. -->
    <dimen name="m3_button_height">52dp</dimen>
    <dimen name="m3_button_radius">26dp</dimen>
    <dimen name="m3_button_height_compact">42dp</dimen>

    <!-- Outlined text fields: 8dp radius, per the M3 text-field shape. -->
    <dimen name="m3_field_radius">10dp</dimen>

    <!-- Bottom navigation:通栏 80dp, 64x32 pill indicator. Not the floating
         M3 capsule — that variant hides the indicator behind a shadow. -->
    <dimen name="m3_nav_height">80dp</dimen>
    <dimen name="m3_nav_indicator_width">64dp</dimen>
    <dimen name="m3_nav_indicator_height">32dp</dimen>
</resources>
