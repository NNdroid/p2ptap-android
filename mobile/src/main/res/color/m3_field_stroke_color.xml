<?xml version="1.0" encoding="utf-8"?>
<!-- Text-field box stroke. Unfocused is the same hairline the mockup measures
     (#CBD5E1), focused is the accent. Validation failures are not handled here:
     TextInputLayout swaps in its own boxStrokeErrorColor for that state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/md_primary" android:state_focused="true" />
    <item android:color="@color/m3_field_stroke" />
</selector>
