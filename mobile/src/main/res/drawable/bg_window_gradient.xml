<?xml version="1.0" encoding="utf-8"?>
<!-- Page backdrop. Flat, not a gradient: in this language depth is carried by
     the card fill being one tonal step away from the page, and a gradient
     behind it would add a second, competing light source.

     There is deliberately no drawable-night variant any more — the fill is
     @color/m3_page, which already resolves to #0B0F19 at night, so one file
     serves both themes. The name is kept because every screen points at it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/m3_page" />
</shape>
