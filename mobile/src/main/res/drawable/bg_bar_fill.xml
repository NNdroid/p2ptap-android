<?xml version="1.0" encoding="utf-8"?>
<!-- Share bar fill. Left white on purpose: TrafficTab tints it per row
     (network layer / transport layer / other), and a tinted-at-inflate fill
     would need a drawable per hue for the same 3dp pill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="3dp" />
</shape>
