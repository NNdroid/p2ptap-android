<?xml version="1.0" encoding="utf-8"?>
<!-- Hero, idle. One flat tonal wash per connection state (idle / connecting /
     connected / error) instead of the old three-layer glass stack — a
     translucent base plus a radial glow plus a top sheen.

     M3 separates a status container by *tone*, not by lighting: all four
     states share this 28dp shape and only the fill shifts, so the hero never
     changes silhouette when the engine changes state. Nothing has to be
     translucent here, which also fixes what the glass version could not: on a
     near-white page a translucent white card has nothing to reveal.

     The radius must track @dimen/home_hero_radius; edited together, or the
     fill pokes out of the MaterialCardView's corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/m3_hero_idle" />
    <corners android:radius="@dimen/home_hero_radius" />
</shape>
