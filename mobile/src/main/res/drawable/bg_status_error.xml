<?xml version="1.0" encoding="utf-8"?>
<!-- Error-status ring behind ivStatus. The other three states reuse
     bg_status_connected / bg_status_connecting / bg_status_disconnected;
     this one existed only as an alias for "disconnected" before, which made
     a failed start look identical to a clean shut-down. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/status_error" />
    <size
        android:width="72dp"
        android:height="72dp" />
</shape>
