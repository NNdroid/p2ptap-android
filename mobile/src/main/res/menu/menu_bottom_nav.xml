<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom navigation: four destinations, no "more" overflow.

     首页 / 节点 / 流量 / 设置 are all Fragments hosted by MainActivity now.
     Settings used to be a separate Activity (ConfigActivity) that inflated
     its own copy of this bar and hopped between screens with Intents; that
     two-screen structure caused the bar-sync bug family — most loudly the
     re-entrancy StackOverflowError of 2026-11-01 — so it was promoted to
     ConfigFragment and this menu is inflated exactly once. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/tabHome"
        android:icon="@drawable/ic_home"
        android:title="@string/tab_home" />

    <item
        android:id="@+id/tabPeers"
        android:icon="@drawable/ic_peers"
        android:title="@string/tab_peers" />

    <item
        android:id="@+id/tabTraffic"
        android:icon="@drawable/ic_traffic"
        android:title="@string/tab_traffic" />

    <item
        android:id="@+id/tabSettings"
        android:icon="@drawable/ic_settings"
        android:title="@string/tab_settings" />

</menu>
