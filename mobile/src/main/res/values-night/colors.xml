    <!-- ── Home hero card (night) ────────────────────────────────────────
         Same flat tonal fill as the light theme; only m3_hero_* differs.
         The old glass stack needed a night-only translucency ladder to sit
         on bg_window_gradient — that backdrop is flat now, so the ladder
         went with it. -->

    <!-- ── M3 Expressive surface language (night) ───────────────────────
         The ladder is page #0B0F19 → card #111827 → pressed #1E293B, which
         is one step deeper than the md_* tokens on purpose: at night the
         card has to sit *below* the page in lightness for the same reason
         the light card sits above it — one step of separation, no stroke. -->
    <color name="m3_page">#0B0F19</color>
    <color name="m3_card">#111827</color>
    <color name="m3_card_press">#1E293B</color>
    <color name="m3_inset">#0C121D</color>
