<?xml version="1.0" encoding="utf-8"?>
<!-- Window backdrop, dark mode.

     This used to be a flat colorSurfaceContainerLow fill. The hero card is now
     translucent glass, and glass over a flat fill is indistinguishable from a
     flat card — there is nothing behind it to reveal. A vertical gradient gives
     the hero something to let through: brightest at the top edge (where the
     status ring and title sit) darkening toward the bottom of the scroll, so the
     card gains depth without any blur pass.

     Three stops instead of two so the falloff stays smooth across the tall home
     scroll; a plain two-stop gradient bands visibly on OLED at these values. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#0A101C"
        android:centerY="0.42"
        android:endColor="#05080E"
        android:startColor="#0D1524"
        android:type="linear" />
</shape>
